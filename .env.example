# ==============================================================================
# RAG Histología — Variables de entorno
# ==============================================================================
# Copiar este archivo a app/.env y completar los valores:
#   cp .env.example app/.env
# ==============================================================================

# ── Groq (REQUERIDO) ─────────────────────────────────────────────────────────
# LLM principal (ver LLM_MODELO). Sin esto el sistema no responde.
# Obtener en: https://console.groq.com/keys
GROQ_API_KEY=
# Opcional: varias keys gratuitas separadas por comas (p. ej. una por integrante).
# Si está definida, cada llamada usa la siguiente key y, ante un límite de uso
# (429), la pone en pausa y reintenta con otra. Vale para el pipeline, el juez
# y GEPA. GROQ_API_KEY se suma al pool si no está repetida.
# Tienen que ser de cuentas distintas: Groq cuenta los límites por organización.
GROQ_API_KEYS=
# Pausa de una key tras un límite, si Groq no indica cuánto esperar ("try
# again in ..."): por minuto (TPM/RPM) y diario (TPD/RPD).
GROQ_COOLDOWN_MINUTO_S=60
GROQ_COOLDOWN_DIARIO_S=3600
# Si todas las keys están en pausa y la primera se libera antes de esto, se
# espera en lugar de fallar (cubre los límites por minuto).
GROQ_ESPERA_MAX_S=90

# Modelo generador. Debe aceptar imágenes (modo multimodal). Para ver qué
# modelos tienen tus keys:  uv run python -m optimizacion.modelos --probar
LLM_MODELO=qwen/qwen3.8-27b
# Qwen razona antes de responder: none lo desactiva (más rápido y gasta menos
# cuota) y hidden oculta el razonamiento. Vacío = no enviar el parámetro.
LLM_REASONING_EFFORT=none
LLM_REASONING_FORMAT=hidden

# ── Qdrant local (OPCIONAL) ──────────────────────────────────────────────────
# Por defecto se usa una base local persistente en app/qdrant_data/.
# No hace falta cuenta ni API key de Qdrant Cloud.
QDRANT_PATH=./qdrant_data

# ── Qdrant Cloud/remoto (OPCIONAL) ───────────────────────────────────────────
# Completar solo si se quiere usar un cluster remoto en lugar de Qdrant local.
QDRANT_URL=
QDRANT_KEY=

# ── Hugging Face (REQUERIDO) ─────────────────────────────────────────────────
# Necesario para descargar los modelos de visión UNI y PLIP.
# 1. Crear cuenta en https://huggingface.co
# 2. Aceptar los términos del modelo en https://huggingface.co/MahmoodLab/UNI
# 3. Generar token en https://huggingface.co/settings/tokens
HF_TOKEN=

# ── LangSmith (OPCIONAL) ─────────────────────────────────────────────────────
# Observabilidad de trazas LangGraph. El sistema funciona sin esto.
# Obtener en: https://smith.langchain.com/
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-histologia

# ── Ajuste fino del LLM (OPCIONAL) ───────────────────────────────────────────
# Segundos que el sistema espera antes de reintentar tras agotar cuota diaria.
LLM_QUOTA_BLOCK_SECONDS=300
# Número de reintentos ante errores transitorios (rate limit, 503).
LLM_MAX_RETRIES=2
# Segundos base de espera entre reintentos (se multiplica por intento).
LLM_RETRY_BASE_SECONDS=8

# ── Servidor / seguridad (OPCIONAL) ──────────────────────────────────────────
# Orígenes CORS permitidos (lista separada por comas, o "*" para abrir todo).
# Por defecto solo localhost/127.0.0.1 (la app se sirve same-origin igual).
ALLOWED_ORIGINS=
# Tamaño máximo (MB) de las imágenes subidas por el chat.
MAX_IMAGE_MB=8

# ── Búsqueda / retrieval (OPCIONAL) ──────────────────────────────────────────
# Umbral de similitud caption<->consulta para mostrar imágenes del manual.
# Más bajo = más imágenes (menos estricto). Subilo si aparecen poco relevantes.
IMG_RERANK_UMBRAL=0.35

# ── Trazas de interacción (OPCIONAL) ─────────────────────────────────────────
# Cada consulta se guarda como una línea JSON en TRAZAS_DIR (un archivo por día).
# Contienen las consultas de los usuarios: no se versionan (ver .gitignore).
TRAZAS_HABILITADAS=true
TRAZAS_DIR=./trazas

# ── LLM as a Judge (OPCIONAL, solo para optimizacion/juez.py) ────────────────
# Proveedor: groq (usa GROQ_API_KEY) u openai (usa OPENAI_API_KEY).
# Modelo por defecto: openai/gpt-oss-120b (groq) / gpt-4o-mini (openai).
JUEZ_PROVEEDOR=groq
JUEZ_MODELO=
OPENAI_API_KEY=

# ── Prompt optimizado con DSPy GEPA (OPCIONAL) ───────────────────────────────
# Usa la instrucción de respuesta evolucionada por optimizacion/gepa.py.
# Desactivado por defecto: activarlo solo después de validarlo contra el baseline.
PROMPTS_OPTIMIZADOS=false
PROMPTS_OPTIMIZADOS_PATH=./optimizacion/optimized_prompts.json
# Tope de tokens de cada respuesta durante GEPA. Debe quedar bajo el límite de
# tokens de salida por minuto del modelo (OTPM: 1000 para Qwen en el plan gratuito).
GEPA_MAX_TOKENS_TAREA=900
