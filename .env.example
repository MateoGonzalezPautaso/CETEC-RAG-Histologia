# ==============================================================================
# RAG Histología — Variables de entorno
# ==============================================================================
# Copiar este archivo a app/.env y completar los valores:
#   cp .env.example app/.env
# ==============================================================================

# ── Groq (REQUERIDO) ─────────────────────────────────────────────────────────
# LLM principal: Llama-4-Scout. Sin esto el sistema no responde.
# Obtener en: https://console.groq.com/keys
GROQ_API_KEY=

# ── Qdrant local (OPCIONAL) ──────────────────────────────────────────────────
# Por defecto se usa una base local persistente en app/qdrant_data/.
# No hace falta cuenta ni API key de Qdrant Cloud.
QDRANT_PATH=./qdrant_data

# ── Qdrant Cloud/remoto (OPCIONAL) ───────────────────────────────────────────
# Completar solo si se quiere usar un cluster remoto en lugar de Qdrant local.
QDRANT_URL=
QDRANT_KEY=

# ── Hugging Face (REQUERIDO) ─────────────────────────────────────────────────
# Necesario para descargar los modelos de visión UNI y PLIP.
# 1. Crear cuenta en https://huggingface.co
# 2. Aceptar los términos del modelo en https://huggingface.co/MahmoodLab/UNI
# 3. Generar token en https://huggingface.co/settings/tokens
HF_TOKEN=

# ── LangSmith (OPCIONAL) ─────────────────────────────────────────────────────
# Observabilidad de trazas LangGraph. El sistema funciona sin esto.
# Obtener en: https://smith.langchain.com/
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-histologia

# ── Ajuste fino del LLM (OPCIONAL) ───────────────────────────────────────────
# Segundos que el sistema espera antes de reintentar tras agotar cuota diaria.
LLM_QUOTA_BLOCK_SECONDS=300
# Número de reintentos ante errores transitorios (rate limit, 503).
LLM_MAX_RETRIES=2
# Segundos base de espera entre reintentos (se multiplica por intento).
LLM_RETRY_BASE_SECONDS=8

# ── Servidor / seguridad (OPCIONAL) ──────────────────────────────────────────
# Orígenes CORS permitidos (lista separada por comas, o "*" para abrir todo).
# Por defecto solo localhost/127.0.0.1 (la app se sirve same-origin igual).
ALLOWED_ORIGINS=
# Tamaño máximo (MB) de las imágenes subidas por el chat.
MAX_IMAGE_MB=8

# ── Búsqueda / retrieval (OPCIONAL) ──────────────────────────────────────────
# Umbral de similitud caption<->consulta para mostrar imágenes del manual.
# Más bajo = más imágenes (menos estricto). Subilo si aparecen poco relevantes.
IMG_RERANK_UMBRAL=0.35

# ── Trazas de interacción (OPCIONAL) ─────────────────────────────────────────
# Cada consulta se guarda como una línea JSON en TRAZAS_DIR (un archivo por día).
# Contienen las consultas de los usuarios: no se versionan (ver .gitignore).
TRAZAS_HABILITADAS=true
TRAZAS_DIR=./trazas

# ── LLM as a Judge (OPCIONAL, solo para optimizacion/juez.py) ────────────────
# Proveedor: groq (usa GROQ_API_KEY) u openai (usa OPENAI_API_KEY).
# Modelo por defecto: llama-3.3-70b-versatile (groq) / gpt-4o-mini (openai).
JUEZ_PROVEEDOR=groq
JUEZ_MODELO=
OPENAI_API_KEY=
