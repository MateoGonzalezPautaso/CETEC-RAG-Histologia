# ─── Secrets y entorno ───────────────────────────────────────────────
.env
.env.local
*.env

# ─── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
app/pyproject.toml
.app/pyproject.toml
# El lock se deriva de pyproject.toml (deps específicas de la máquina: CPU/CUDA),
# así que también es local. Cada máquina regenera el suyo con `uv lock`/`uv sync`.
app/uv.lock

# ─── Entornos virtuales ──────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ─── Jupyter Notebooks ───────────────────────────────────────────────
.ipynb_checkpoints/
*-checkpoint.ipynb

# ─── Datos (no versionar contenido pesado o sensible) ────────────────
# Si querés versionar los PDFs, comentá esta línea:
data/pdfs/*.pdf
data/imagenes_extraidas/
data/*.json

# ─── Outputs y trazas generadas ──────────────────────────────────────
outputs/
trayectoria_histologia.json
trayectoria_qdrant.json
trayectoria_neo4j.json
temario_histologia.json
temario_histologia.sha256
.qdrant_index_complete
logs/
eval_reliability_report.json
reporte_ragas.json
# Trazas de interacción: contienen las consultas de los usuarios.
app/trazas/

# ─── Imágenes subidas por usuarios en el chat ─────────────────────────
imagenes_chat/
imagenes_extraidas/

# ─── Modelos descargados (cache de HuggingFace) ──────────────────────
.cache/
hf_cache/
*.bin
*.safetensors
*.pt
*.pth

# ─── IDEs ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Persistencia local de Qdrant (si se usa local) ──────────────────
qdrant_data/
qdrant_memoria/

# ─── Archivos temporales ─────────────────────────────────────────────
*.tmp
*.bak
*~
